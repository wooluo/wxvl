{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/dir-traverse"
    }
  ],
  "outputDirectory": ".",
  "headers": [
    {
      "source": "**/*",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Charset", "value": "utf-8" }
      ]
    }
  ]
}
