{
  "rewrites": [
    {
      "source": "/(.*).md",
      "destination": "/api/render"
    }
  ],
  "outputDirectory": "doc",
  "headers": [
    {
      "source": "**/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Charset",
          "value": "utf-8"
        }
      ]
    }
  ]
}
