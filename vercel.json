{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/dir-traverse.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    }
  ],
  "functions": {
    "api/dir-traverse.js": {
      "runtime": "edge"
    }
  }
}
