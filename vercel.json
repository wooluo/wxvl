{
  "outputDirectory": "wxvl/doc",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "**/*.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
